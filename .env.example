# Required bootstrap settings. Keep the real file outside version control.
ADMIN_TELEGRAM_ID=123456789
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
PUBLIC_BASE_URL=https://carpool.example.com
# Exactly 32 random bytes, base64 encoded. Example generator:
#   openssl rand -base64 32
CONFIG_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Runtime defaults
PORT=8080
DATA_DIR=/data
TZ=UTC
LOG_LEVEL=info
# Local development only. Production must keep HTTPS enforcement enabled.
# ALLOW_INSECURE_HTTP=false

# Remnawave and payment provider URLs, credentials, signing keys, exchange
# rates, Telegram chat IDs, and the BEPusdt acknowledgement body are managed
# in the admin dashboard. Secret values are encrypted at rest and are never
# returned after they are written.
