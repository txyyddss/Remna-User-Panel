{
  "name": "tx-carpool-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.5.0",
    "vue": "3.5.40",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "^24.1.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/language-core": "^3.3.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^20.11.1",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.4"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    }
  }
}
